# ======================
# Multi-Tenant SaaS E-commerce Platform
# Environment Configuration Example
# ======================
# Copy this file to .env and fill in your actual values
# cp .example.env .env
# ======================

# Application Environment
NODE_ENV=development
PORT=3000
BACKEND_IP=localhost

# ======================
# Database Configuration
# ======================
MONGODB_URL=mongodb://localhost:27017/multi-tenant-saas

# ======================
# JWT Configuration
# ======================
JWT_SECRET=change-this-to-a-random-secure-string
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=30

# ======================
# Redis Configuration
# ======================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ======================
# Email / SMTP Configuration
# ======================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourplatform.com

# ======================
# Stripe Payment Configuration
# ======================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ======================
# Cloudinary Image Storage (Optional)
# ======================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ======================
# Platform Configuration
# ======================
PLATFORM_URL=http://localhost:3000
PLATFORM_NAME=Your SaaS Platform
DEFAULT_TRIAL_PERIOD_DAYS=14

# ======================
# Security Configuration
# ======================
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ======================
# Master Admin Default Credentials
# ======================
DEFAULT_ADMIN_EMAIL=admin@yourplatform.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!@#

# ======================
# Feature Flags
# ======================
ENABLE_EMAIL_VERIFICATION=true
ENABLE_SUBSCRIPTION_JOB=true
